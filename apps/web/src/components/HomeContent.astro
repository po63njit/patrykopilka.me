---
import OrbitScene from "./OrbitScene.astro";
import MatrixWaves from "./MatrixWaves.astro";
import { getCollection } from "astro:content";
const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const post = posts[0];
---

<section class="home home--orbital">
  <MatrixWaves />
  <div class="home-heading">
    <p class="eyebrow">
      <span class="signal"></span> Computer engineering / Personal orbit
    </p>
    <h1>
      Patryk Opilka<span>.</span>
    </h1>
    <p class="home-description">
      Computer engineering, from the metal up.
      <br class="mobile-break" /> A place for things I build, learn, and
      explore.
    </p>
  </div>
  <div class="home-universe">
    <OrbitScene />
  </div>
</section>
<section class="home-bottom" aria-label="Around the site">
  <div class="bottom-heading">
    <span class="eyebrow">Beyond the orbit</span>
    <p>
      A workbench for ideas.
      <br />
      Always a little unfinished.
    </p>
  </div>
  <a href="/projects" class="bottom-link">
    <span class="eyebrow">The workbench</span>
    <h2>
      Projects in progress <span class="arrow-icon" aria-hidden="true"></span>
    </h2>
    <p>Making room for work worth sharing.</p>
  </a>
  {post ? (
    <a href={`/blog/${post.slug}`} class="bottom-link">
      <>
        <span class="eyebrow">Latest field note</span>
        <h2>
          {post.data.title} <span class="arrow-icon" aria-hidden="true" />
        </h2>
        <p>
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "short",
              day: "numeric",
              timeZone: "UTC",
            })}
          </time>{" "}
          · Read the note
        </p>
      </>
    </a>
  ) : (
    <a href="/blog" class="bottom-link">
      <>
        <span class="eyebrow">Field notes</span>
        <h2>
          Writing <span class="arrow-icon" aria-hidden="true" />
        </h2>
        <p>Notes, questions, and things learned.</p>
      </>
    </a>
  )}
</section>
<style>
  .home {
    position: relative;
    isolation: isolate;
    padding-top: 54px;
  }
  .home-heading {
    text-align: center;
    position: relative;
    z-index: 2;
  }
  .home-heading .eyebrow {
    margin-bottom: 19px;
  }
  .signal {
    display: inline-block;
    width: 5px;
    height: 5px;
    background: var(--accent);
    border-radius: 50%;
    margin-right: 8px;
    vertical-align: 2px;
  }
  .home h1 {
    font-size: clamp(3.2rem, 7.5vw, 6.4rem);
    font-weight: 500;
    margin-bottom: 18px;
    line-height: 0.98;
    letter-spacing: -0.065em;
  }
  .home h1 span,
  .home h1 em {
    color: var(--accent);
  }
  .home-description {
    font-size: 14px;
    color: #a5b5ae;
    line-height: 1.7;
    margin-bottom: 0;
  }
  .home-universe {
    max-width: 940px;
    margin: 8px auto 0;
  }
  .mobile-break {
    display: none;
  }
  .home-bottom {
    display: grid;
    grid-template-columns: 1fr 1.15fr 1.15fr;
    border-top: 1px solid var(--line);
    margin-top: 32px;
    padding-top: 26px;
    gap: 36px;
  }
  .bottom-heading .eyebrow,
  .bottom-link .eyebrow {
    font-size: 8px;
    letter-spacing: 0.15em;
  }
  .bottom-heading p {
    font-size: 14px;
    line-height: 1.5;
    color: #a1afa9;
    margin-top: 12px;
  }
  .bottom-link {
    display: block;
    text-decoration: none;
    border-left: 1px solid var(--line);
    padding-left: 36px;
  }
  .bottom-link h2 {
    font-size: 19px;
    margin: 12px 0 8px;
    display: flex;
    justify-content: space-between;
    letter-spacing: -0.02em;
  }
  .bottom-link h2 span {
    color: var(--accent);
    font-weight: 300;
  }
  .bottom-link p {
    font-size: 11px;
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 800px) {
    .home-bottom {
      gap: 20px;
    }
    .bottom-link {
      padding-left: 20px;
    }
  }
  @media (max-width: 650px) {
    .home {
      padding-top: 36px;
    }
    .home-heading .eyebrow {
      font-size: 8px;
      letter-spacing: 0.09em;
    }
    .home h1 {
      font-size: clamp(2.7rem, 10vw, 4rem);
    }
    .home-description {
      font-size: 12px;
    }
    .mobile-break {
      display: block;
    }
    .home-universe {
      margin-top: 4px;
    }
    .home-bottom {
      grid-template-columns: 1fr;
      margin-top: 22px;
      padding-top: 20px;
      gap: 22px;
    }
    .bottom-heading {
      display: none;
    }
    .bottom-link {
      padding-left: 0;
      border-left: 0;
    }
    .bottom-link + .bottom-link {
      border-top: 1px solid var(--line);
      padding-top: 22px;
    }
    .bottom-link h2 {
      font-size: 20px;
    }
  }
</style>
