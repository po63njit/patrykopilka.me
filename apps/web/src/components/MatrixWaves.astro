---
import { createWaveField, moveWaves, wavePath } from "../scripts/matrix-waves";
const lines = createWaveField(1200, 800);
moveWaves(lines, 0);
---
<div class="matrix-waves" data-matrix-waves aria-hidden="true">
  <svg viewBox="0 0 1200 800" preserveAspectRatio="none" focusable="false">
    {lines.map((points) => <path d={wavePath(points)} />)}
  </svg>
</div>
<script>
  import "../scripts/matrix-waves";
</script>
<style>
  .matrix-waves {
    position: absolute;
    inset: -22px calc(-1 * var(--pad)) 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: #020805;
    mask-image: linear-gradient(transparent, #000 15%, #000 84%, transparent);
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: #23d65c;
    stroke-width: 0.8;
    opacity: 0.28;
    mask-image: radial-gradient(ellipse at 50% 37%, #0005, #000 72%);
  }
  .matrix-waves :global(path:nth-child(5n)) { stroke: #6bff99; }
  @media (max-width: 650px) {
    svg { opacity: 0.22; }
  }
</style>
