---
const interests = [
  {
    number: "01",
    title: "Computer architecture",
    detail: "RISC-V · Embedded systems",
    description:
      "The instructions, interfaces, and hardware beneath the software.",
  },
  {
    number: "02",
    title: "Signals & positioning",
    detail: "GNSS · Hardware experiments",
    description:
      "Connecting physical signals with the systems that interpret them.",
  },
  {
    number: "03",
    title: "Machine learning",
    detail: "ML · Intelligent systems",
    description: "Exploring how computation turns data into useful behavior.",
  },
];
---

<div class="about-page about-page--systems">
  <section class="systems-hero" aria-labelledby="about-title">
    <div class="systems-intro">
      <p class="overline">
        <span class="status-mark" aria-hidden="true" />
        Patryk Opilka / About
      </p>
      <h1 id="about-title">
        Hardware.
        <br />
        Software.
        <>
          <br />
          <span>Everything between.</span>
        </>
      </h1>
      <p class="hero-description">
        I’m a Computer Engineering graduate student @ NJIT building across the boundary between
        code and the physical world.
      </p>
      <a class="text-link" href="/projects">
        Explore my projects <span class="arrow-icon" aria-hidden="true" />
      </a>
    </div>
    <div class="systems-figure" aria-hidden="true">
      <div class="figure-top">
        <>
          <span>FIG. 01</span>
          <span>SYSTEMS / LAYERS</span>
        </>
      </div>
      <svg class="stack-diagram" viewBox="0 0 440 440" fill="none">
        <defs>
          <pattern
            id="about-dot-grid"
            width="20"
            height="20"
            patternUnits="userSpaceOnUse"
          >
            <circle cx="1" cy="1" r="1" fill="currentColor" opacity=".18" />
          </pattern>
          <linearGradient
            id="about-layer-fill"
            x1="220"
            y1="100"
            x2="220"
            y2="340"
            gradientUnits="userSpaceOnUse"
          >
            <>
              <stop stop-color="#a7f3d0" stop-opacity=".07" />
              <stop offset="1" stop-color="#a7f3d0" stop-opacity=".01" />
            </>
          </linearGradient>
        </defs>
        <rect width="440" height="440" fill="url(#about-dot-grid)" />
        <path
          d="M220 32V405M35 220H405"
          stroke="currentColor"
          opacity=".12"
          stroke-dasharray="3 7"
        />
        <path
          d="M65 280L220 195L375 280L220 365Z"
          fill="url(#about-layer-fill)"
          stroke="currentColor"
          opacity=".35"
        />
        <path
          d="M65 280V295L220 380L375 295V280M220 365V380"
          stroke="currentColor"
          opacity=".2"
        />
        <path
          d="M65 200L220 115L375 200L220 285Z"
          fill="#111b1b"
          stroke="currentColor"
          opacity=".6"
        />
        <path
          d="M65 200V215L220 300L375 215V200M220 285V300"
          stroke="currentColor"
          opacity=".35"
        />
        <path
          d="M65 120L220 35L375 120L220 205Z"
          fill="#13201d"
          stroke="currentColor"
        />
        <path
          d="M65 120V135L220 220L375 135V120M220 205V220"
          stroke="currentColor"
          opacity=".55"
        />
        <path
          d="M147 120L220 80L293 120L220 160Z"
          stroke="currentColor"
          opacity=".8"
        />
        <path
          d="M173 120L220 94L267 120L220 146Z"
          fill="currentColor"
          fill-opacity=".15"
          stroke="currentColor"
          opacity=".5"
        />
        <path
          d="M220 52V78M220 162V188M101 120H145M295 120H339M160 86L178 96M262 144L280 154M160 154L178 144M262 96L280 86"
          stroke="currentColor"
          opacity=".5"
        />
        <path
          d="M65 146V264M375 146V264"
          stroke="currentColor"
          opacity=".24"
          stroke-dasharray="3 6"
        />
        <circle cx="220" cy="120" r="3" fill="currentColor" />
        <circle cx="65" cy="280" r="3" fill="currentColor" opacity=".55" />
        <circle cx="375" cy="280" r="3" fill="currentColor" opacity=".55" />
      </svg>
      <div class="figure-bottom">
        <>
          <span>HARDWARE ↔ SOFTWARE</span>
          <span>01—03</span>
        </>
      </div>
    </div>
  </section>
  <section class="profile-section" aria-labelledby="profile-title">
    <div class="section-label">
      <>
        <span>01 / Background</span>
        <h2 id="profile-title">A little context.</h2>
      </>
    </div>
    <div class="profile-copy">
      <p class="lead-copy">
        My work brings together RISC-V, GNSS, machine learning, and hands-on
        hardware experiments.
      </p>
      <p>
        Those projects span different parts of computer engineering, from
        low-level systems to the software built around them. This site is where
        I collect the work and write about what goes into it.
      </p>
      <div class="inline-links">
        <>
          <a href="/blog">
            Read the notes <span class="arrow-icon" aria-hidden="true" />
          </a>
          <a
            href="https://github.com/po63njit"
            target="_blank"
            rel="noreferrer"
          >
            View the code <span class="arrow-icon" aria-hidden="true" />
          </a>
        </>
      </div>
    </div>
  </section>
  <section class="interest-section" aria-labelledby="interests-title">
    <div class="section-label">
      <>
        <span>02 / Areas of interest</span>
        <h2 id="interests-title">Across the stack.</h2>
      </>
    </div>
    <div class="interest-list">
      {interests.map((interest) => (
        <div class="interest-row">
          <span class="interest-number">{interest.number}</span>
          <h3>{interest.title}</h3>
          <p>{interest.detail}</p>
        </div>
      ))}
    </div>
  </section>
  <footer class="about-contact">
    <>
      <span>Have something in mind?</span>
      <a href="mailto:po63@njit.edu">
        Let’s talk <span class="arrow-icon" aria-hidden="true" />
      </a>
    </>
  </footer>
</div>

<style>
  .about-page {
    --about-accent: #a7f3d0;
    --about-text: #edf1ed;
    --about-muted: #a2aca8;
    --about-line: #2b3330;
    padding-block: 1.25rem 3rem;
    color: var(--about-text);
  }
  .about-page a {
    text-decoration: none;
  }
  .about-page a:focus-visible {
    outline: 2px solid var(--about-accent);
    outline-offset: 6px;
  }
  .overline,
  .figure-top,
  .figure-bottom,
  .section-label > span,
  .interest-number {
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.065em;
  }
  .systems-hero {
    display: grid;
    grid-template-columns: 1.18fr 1fr;
    align-items: center;
    gap: 5%;
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
  }
  .overline {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-transform: uppercase;
    color: var(--about-muted);
    margin: 0 0 2rem;
  }
  .status-mark {
    display: inline-block;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--about-accent);
  }
  .systems-intro h1 {
    font-size: clamp(2.7rem, 5.65vw, 4.75rem);
    line-height: 1.06;
    letter-spacing: -0.065em;
    font-weight: 500;
    margin: 0 0 1.8rem;
    color: var(--about-text);
  }
  .systems-intro h1 span {
    color: var(--about-accent);
  }
  .hero-description {
    max-width: 28rem;
    font-size: 1rem;
    line-height: 1.8;
    color: var(--about-muted);
    margin: 0 0 1.7rem;
  }
  .text-link {
    display: inline-flex;
    gap: 2rem;
    align-items: center;
    color: var(--about-text);
    font-size: 0.85rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid #68756d;
  }
  .text-link span {
    color: var(--about-accent);
    font-size: 1.1rem;
  }
  .text-link:hover {
    border-color: var(--about-accent);
  }
  .systems-figure {
    color: var(--about-accent);
    padding: 1rem 0;
  }
  .figure-top,
  .figure-bottom {
    display: flex;
    justify-content: space-between;
    color: #8b9c91;
    font-size: 0.58rem;
  }
  .figure-top {
    border-top: 1px solid var(--about-line);
    padding-top: 1rem;
  }
  .figure-bottom {
    border-bottom: 1px solid var(--about-line);
    padding-bottom: 1rem;
  }
  .stack-diagram {
    display: block;
    width: 100%;
    max-width: 460px;
    margin: 0.75rem auto;
  }
  .profile-section,
  .interest-section {
    display: grid;
    grid-template-columns: 1fr 1.7fr;
    gap: 4rem;
    padding-block: 3.5rem;
    border-top: 1px solid var(--about-line);
  }
  .section-label > span {
    color: var(--about-muted);
    text-transform: uppercase;
  }
  .section-label h2 {
    margin: 1rem 0 0;
    font-size: 1.5rem;
    line-height: 1.3;
    font-weight: 450;
    letter-spacing: -0.03em;
    color: var(--about-text);
  }
  .profile-copy p {
    margin: 0 0 1.2rem;
    color: var(--about-muted);
    font-size: 0.95rem;
    line-height: 1.9;
  }
  .profile-copy .lead-copy {
    font-size: 1.4rem;
    line-height: 1.6;
    letter-spacing: -0.025em;
    color: var(--about-text);
  }
  .inline-links {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin-top: 1.75rem;
  }
  .inline-links a {
    color: var(--about-accent);
    font-size: 0.8rem;
  }
  .inline-links a span {
    margin-left: 0.6rem;
  }
  .interest-row {
    display: grid;
    grid-template-columns: 2.3rem 1fr;
    column-gap: 0.6rem;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--about-line);
  }
  .interest-row:first-child {
    padding-top: 0;
  }
  .interest-row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .interest-number {
    grid-row: span 2;
    color: #8b9c91;
    padding-top: 0.25rem;
  }
  .interest-row h3 {
    color: var(--about-text);
    font-size: 1.05rem;
    font-weight: 450;
    letter-spacing: -0.01em;
    margin: 0 0 0.3rem;
  }
  .interest-row p {
    margin: 0;
    color: var(--about-muted);
    font-size: 0.75rem;
    line-height: 1.65;
  }
  .about-contact {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    border-block: 1px solid var(--about-line);
    padding: 2rem 0;
  }
  .about-contact > span {
    color: var(--about-muted);
    font-size: 0.85rem;
  }
  .about-contact a {
    font-size: 1.65rem;
    letter-spacing: -0.04em;
    color: var(--about-text);
  }
  .about-contact a span {
    display: inline-block;
    margin-left: 2rem;
    color: var(--about-accent);
  }

  /* Direction 02: a paper-like editorial layout with a different reading rhythm. */

  /* Direction 03: static field notes, not a simulated interactive terminal. */

  @media (max-width: 900px) {
    .systems-hero {
      gap: 2rem;
      grid-template-columns: 1.2fr 1fr;
    }
    .systems-intro h1 {
      font-size: clamp(2.5rem, 5.7vw, 4.75rem);
    }
    .profile-section,
    .interest-section {
      grid-template-columns: 1fr 1.6fr;
      gap: 2rem;
    }
  }
  @media (max-width: 640px) {
    .about-page {
      padding-top: 0.5rem;
    }
    .systems-hero {
      grid-template-columns: 1fr;
      padding-top: 2.5rem;
      gap: 2.5rem;
    }
    .systems-intro h1 {
      font-size: clamp(2.7rem, 10.5vw, 4.1rem);
    }
    .systems-figure {
      max-width: 27rem;
      width: 100%;
      margin-inline: auto;
    }
    .stack-diagram {
      max-height: 330px;
    }
    .hero-description {
      max-width: 26rem;
      font-size: 0.93rem;
    }
    .profile-section,
    .interest-section {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-block: 2.5rem;
    }
    .profile-copy .lead-copy {
      font-size: 1.25rem;
    }
    .about-contact a {
      font-size: 1.4rem;
    }
    .about-contact a span {
      margin-left: 0.6rem;
    }
    .about-contact > span {
      font-size: 0.72rem;
    }
  }
</style>
