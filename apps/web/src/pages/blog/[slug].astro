---
import BlogLayout from "../../layouts/BlogLayout.astro";
import MemoryDiagram from "../../components/blog/MemoryDiagram.astro";
import { getCollection } from "astro:content";
export async function getStaticPaths(){return (await getCollection("blog",({data})=>!data.draft)).map(post=>({params:{slug:post.slug},props:{post}}));}
const {post}=Astro.props;
const {Content,headings}=await post.render();
const hero=post.data.hero;
const byteOrder=hero?.kind==="byte-order";
const outline=headings.filter(h=>h.depth===2);
const readMinutes=Math.ceil(post.body.split(/\s+/).length/220);
const dateLabel=post.data.date.toLocaleDateString("en-US",{month:"long",day:"numeric",year:"numeric",timeZone:"UTC"});
---
<BlogLayout title={`${post.data.title} — Patryk Opilka`} description={post.data.description??"Technical notes from Patryk Opilka."}>
  {byteOrder ? <section class="hero" aria-labelledby="article-title">
    <div class="hero-copy"><p class="eyebrow"><span class="tiny-square"></span> {hero.eyebrow}</p><h1 id="article-title" aria-label={hero.titleLines.join("")}>{hero.titleLines[0]}<span class="break">{hero.titleLines[1]}<span class="title-dot">.</span></span></h1><div class="hero-deck"><span class="hero-rule"></span><p>{hero.deck}<br /><em>{hero.emphasis}</em></p></div><p class="hero-summary">{hero.summary}</p><div class="hero-actions"><a class="start-reading" href={`#${outline[0]?.slug}`}>Start reading <span>↓</span></a></div></div>
    <MemoryDiagram />
  </section> : <header class="simple-article-header"><p class="eyebrow">FROM THE JOURNAL</p><h1>{post.data.title}</h1>{post.data.description&&<p>{post.data.description}</p>}</header>}
  <div class="article-meta"><div><span class="meta-label">BY</span><span>Patryk Opilka</span></div><div><span class="meta-label">PUBLISHED</span><time datetime={post.data.date.toISOString()}>{dateLabel}</time></div><div><span class="meta-label">READING TIME</span><span>{readMinutes} min</span></div>{byteOrder&&<a href="#byte-lab">Jump to byte lab ↙</a>}</div>
  <div class:list={["reading-layout",{"without-outline":outline.length===0}]}>
    {outline.length>0 && <aside class="contents"><p class="eyebrow">ON THIS PAGE</p><nav aria-label="Article sections">{outline.map((h,i)=><><a href={`#${h.slug}`}><span>{String(i).padStart(2,"0")}</span>{h.text.replace(/^\d+\s+/,"")}</a>{byteOrder&&i===1&&<a href="#byte-lab"><span>↔</span>Interactive byte lab</a>}</>)}</nav><p class="toc-footer">FOLLOW THE DETAILS.<br />QUESTION THE BOUNDARIES.</p></aside>}
    <article class="article-body" aria-label={post.data.title}>
      {byteOrder&&<div class="reading-mode"><span>{outline.filter(h=>/^\d+ /.test(h.text)).length} CHAPTERS{hero?.status&&` · ${hero.status}`}</span><a href="/blog">All articles ↗</a></div>}
      <Content />

      <p class="back-link"><a href="/blog">← Back to the journal</a></p>
    </article>
  </div>
</BlogLayout>
