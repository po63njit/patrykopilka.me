---
import BlogLayout from "../../layouts/BlogLayout.astro";
import { getCollection } from "astro:content";
const posts=(await getCollection("blog",({data})=>!data.draft)).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime());
const [featured,...older]=posts;
---
<BlogLayout>
  <section class="journal-intro"><p class="eyebrow">NOTES FROM CLOSE TO THE METAL</p><h1>Small details.<br /><em>Deep systems.</em></h1><div class="journal-bottom"><p>Essays on how computers work.<br />From individual bytes to the boundaries between systems.</p><span class="journal-index">THE JOURNAL<br />{posts.length} {posts.length===1?"ARTICLE":"ARTICLES"}</span></div></section>
  {featured ? <>
    <div class="section-label"><span>LATEST ARTICLE</span><span>SYSTEMS · FIELD NOTES</span></div>
    <a class="featured-article" href={`/blog/${featured.slug}/`}>
      <div class="featured-art" aria-hidden="true"><span class="art-small">ADDRESS →</span><div class="featured-bytes"><b>12</b><b>34</b><b>56</b><b>78</b></div><div class="featured-bytes reversed"><b>78</b><b>56</b><b>34</b><b>12</b></div><span class="art-small bottom">SAME VALUE. DIFFERENT ORDER.</span></div>
      <div class="featured-copy"><p class="eyebrow">{featured.data.tags.join(" / ")}</p><h2>{featured.data.hero?`${featured.data.hero.titleLines.join("")}.`:featured.data.title}</h2><p>{featured.data.description??"Notes, questions, and experiments."}</p><span class="read-link">Explore the article <span>↗</span></span><time class="draft-note" datetime={featured.data.date.toISOString()}>{featured.data.date.toLocaleDateString("en-US",{month:"long",day:"numeric",year:"numeric",timeZone:"UTC"})}</time></div>
    </a>
    {older.length>0 && <section class="older-posts" aria-label="Earlier articles"><div class="section-label"><span>EARLIER NOTES</span><span>{older.length}</span></div>{older.map(post=><article><h2><a href={`/blog/${post.slug}/`}>{post.data.title} <span aria-hidden="true">↗</span></a></h2>{post.data.description&&<p>{post.data.description}</p>}<time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString("en-US",{month:"long",day:"numeric",year:"numeric",timeZone:"UTC"})}</time></article>)}</section>}
  </> : <p class="empty">Nothing published yet. A quiet place to begin.</p>}
  <div class="journal-note"><span aria-hidden="true">⌁</span><p>A place for careful explanations,<br />reproducible examples, and questions worth following.</p><a href="/">Back to the portfolio ↗</a></div>
</BlogLayout>
