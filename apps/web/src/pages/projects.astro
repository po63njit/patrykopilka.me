---
import BaseLayout from "../layouts/BaseLayout.astro";
const placeholders = [
  {
    number: "01",
    type: "Software & systems",
    title: "A space for the next build.",
    description:
      "Selected projects will return with working demos, clear documentation, and the details that matter.",
    shape: "cube",
  },
  {
    number: "02",
    type: "Hardware & experiments",
    title: "Back on the workbench.",
    description:
      "A place for experiments, prototypes, and lessons from making things work.",
    shape: "wave",
  },
  {
    number: "03",
    type: "Tools & everyday problems",
    title: "Useful things, made carefully.",
    description:
      "More soon. For now, this is a deliberately quiet corner of the site.",
    shape: "grid",
  },
];
---

<BaseLayout
  title="Projects — Patryk Opilka"
  description="A workbench for software, hardware, and experiments."
>
  <section class="projects-intro">
    <p class="eyebrow">The workbench / Selected work</p><h1>
      Good work takes<br /><em>a little tending.</em>
    </h1><div class="intro-bottom">
      <p>
        I’m cleaning up the workbench. Projects will return here when they’re
        ready to be explored properly.
      </p><span class="status"><i></i> IN PROGRESS</span>
    </div>
  </section>
  <section class="project-placeholders" aria-label="Upcoming project spaces">
    {
      placeholders.map((p) => (
        <article class="project-slot">
          <>
            <div class={`slot-art slot-art--${p.shape}`} aria-hidden="true">
              <>
                <span class="slot-number">{p.number}</span>
                <div class="art-object" />
                <span class="art-label">WORK IN PROGRESS / {p.number}</span>
              </>
            </div>
            <div class="slot-copy">
              <>
                <p class="eyebrow">{p.type}</p>
                <h2>{p.title}</h2>
                <p>{p.description}</p>
                <span class="slot-status">
                  Being prepared <span class="arrow-icon" aria-hidden="true" />
                </span>
              </>
            </div>
          </>
        </article>
      ))
    }
  </section>
  <p class="projects-end">
    In the meantime, you can find my repositories on <a
      href="https://github.com/po63njit">GitHub</a
    >.
  </p>
</BaseLayout>
<style>
  .projects-intro {
    padding: 70px 0 46px;
    border-bottom: 1px solid var(--line);
  }
  .projects-intro h1 {
    font-size: clamp(3rem, 6.7vw, 5.8rem);
    line-height: 1.05;
    margin: 26px 0 30px;
  }
  .projects-intro h1 em {
    font-family: Georgia, serif;
    font-weight: 400;
    color: var(--accent);
  }
  .intro-bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }
  .intro-bottom p {
    max-width: 470px;
    color: var(--muted);
    font-size: 15px;
    margin: 0;
  }
  .status {
    font: 9px var(--mono);
    letter-spacing: 0.15em;
    white-space: nowrap;
    color: var(--accent);
    margin-bottom: 4px;
  }
  .status i {
    display: inline-block;
    width: 5px;
    height: 5px;
    background: var(--accent);
    border-radius: 50%;
    margin-right: 8px;
  }
  .project-placeholders {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 36px 0;
  }
  .project-slot {
    min-width: 0;
  }
  .slot-art {
    height: 230px;
    position: relative;
    background: #111d20;
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .slot-art--wave {
    background: #171a20;
  }
  .slot-art--grid {
    background: #211e17;
  }
  .slot-number {
    position: absolute;
    top: 18px;
    left: 20px;
    font: 11px var(--mono);
    color: #839d93;
  }
  .art-label {
    position: absolute;
    left: 20px;
    bottom: 18px;
    font: 7px var(--mono);
    letter-spacing: 0.16em;
    color: #789084;
  }
  .art-object {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(30deg);
    width: 84px;
    height: 84px;
    border: 1px solid #a7f3d055;
    box-shadow:
      18px -18px 0 -1px #111d20,
      18px -18px 0 0 #a7f3d030;
  }
  .slot-art--wave .art-object {
    width: 150px;
    height: 70px;
    border-radius: 50%;
    transform: translate(-50%, -50%) rotate(-25deg);
    box-shadow:
      0 12px 0 -1px #171a20,
      0 13px 0 #91a9e43b,
      0 -13px 0 -1px #171a20,
      0 -14px 0 #91a9e43b;
    border-color: #91a9e45c;
  }
  .slot-art--grid .art-object {
    width: 110px;
    height: 110px;
    border: 0;
    transform: translate(-50%, -50%);
    box-shadow: none;
    background: radial-gradient(circle, #d5b9845e 2px, transparent 3px);
    background-size: 22px 22px;
  }
  .slot-copy {
    padding: 24px 0;
  }
  .slot-copy .eyebrow {
    font-size: 8px;
  }
  .slot-copy h2 {
    font-size: 24px;
    line-height: 1.15;
    margin: 16px 0;
  }
  .slot-copy > p:not(.eyebrow) {
    font-size: 13px;
    color: var(--muted);
    min-height: 66px;
  }
  .slot-status {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    padding-top: 18px;
    margin-top: 26px;
    font: 9px var(--mono);
    color: #71887d;
  }
  .projects-end {
    font-size: 12px;
    color: var(--muted);
    margin: 40px 0;
  }
  .projects-end a {
    color: var(--accent);
  }
  @media (max-width: 760px) {
    .projects-intro {
      padding-top: 42px;
    }
    .intro-bottom {
      align-items: flex-start;
      flex-direction: column;
    }
    .project-placeholders {
      grid-template-columns: 1fr;
    }
    .slot-art {
      height: 240px;
    }
    .slot-copy > p:not(.eyebrow) {
      min-height: 0;
    }
    .slot-copy {
      padding-bottom: 0;
    }
    .slot-status {
      margin-top: 20px;
    }
    .projects-intro h1 {
      font-size: 3.1rem;
    }
  }
</style>
