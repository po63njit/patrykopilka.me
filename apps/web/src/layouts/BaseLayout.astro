---
import "../styles/global.scss";
const {
  title = "Patryk Opilka",
  description = "Computer engineering, systems, and experiments.",
} = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const links = [
  { url: "/blog/", label: "Writing" },
  { url: "/projects/", label: "Projects" },
  { url: "/resume/", label: "Résumé" },
  { url: "/about/", label: "About" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <a href="/" class="brand" aria-label="Patryk Opilka, home">
        <span class="brand-mark" aria-hidden="true">
          ◇
        </span>{" "}
        patryk<span class="brand-light">opilka</span>
        <span class="brand-dot">.</span>
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        {links.map((link) => (
          <a
            href={link.url}
            aria-current={path === link.url || `${path}/` === link.url ? "page" : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Patryk Opilka</p>
      <p>Made with curiosity. Built with Astro.</p>
      <a href="https://github.com/po63njit">
        GitHub <span class="arrow-icon" aria-hidden="true"></span>
      </a>
    </footer>
  </body>
</html>
